{
  "components": {
    "schemas": {
      "FlatCreateFlowchartRequest": {
        "type": "object",
        "properties": {
          "payload": {
            "description": "The flowchart to create, with its nodes and the connections between them. Mandatory.",
            "type": "object",
            "properties": {
              "nodes": {
                "minItems": 1,
                "maxItems": 50,
                "description": "1 to 50 nodes; positions are computed by the server, never supplied.",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "preferred_shape": {
                      "description": "Flowchart symbol, for example TERMINATOR for start/end, PROCESS, DECISION, DATA, DOCUMENT; default PROCESS.",
                      "type": "string",
                      "maxLength": 40,
                      "enum": [
                        "PREDEFINED_PROCESS",
                        "INTERNAL_STORAGE",
                        "DOCUMENT",
                        "PROCESS",
                        "ALTERNATE_PROCESS",
                        "DECISION",
                        "DATA",
                        "MULTI_DOCUMENT",
                        "TERMINATOR",
                        "PREPARATION",
                        "MANUAL_INPUT",
                        "MANUAL_OPERATION",
                        "CONNECTOR",
                        "OFFPAGE_CONNECTOR",
                        "PUNCHED_CARD",
                        "PUNCHED_TAPE",
                        "SUMMING_JUNCTION",
                        "OR",
                        "COLLATE",
                        "SORT",
                        "EXTRACT",
                        "MERGE",
                        "STORED_DATA",
                        "DELAY",
                        "SEQUENTIAL_ACCESS_STORAGE",
                        "MAGNETIC_DISK",
                        "DIRECT_ACCESS_STORAGE",
                        "DISPLAY"
                      ]
                    },
                    "text": {
                      "description": "Label shown inside the node.",
                      "type": "string",
                      "maxLength": 5000
                    },
                    "node_id": {
                      "description": "Stable client-chosen id, unique within the payload; edges reference it.",
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "node_id"
                  ]
                }
              },
              "max_depth": {
                "format": "int32",
                "description": "Maximum number of layers (longest root-to-leaf chain), 1 to 5; default 5. Deeper graphs are rejected.",
                "type": "integer"
              },
              "edges": {
                "minItems": 1,
                "maxItems": 100,
                "description": "Directed edges between node ids (up to 100); when empty the server may chain the nodes linearly.",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from_node_id": {
                      "description": "node_id of the edge's source node.",
                      "type": "string",
                      "maxLength": 200
                    },
                    "start_marker": {
                      "description": "Arrowhead at the source end: NONE, OPEN, BLOCK, CLASSIC, DIAMOND or OVAL; default none.",
                      "type": "string",
                      "maxLength": 20,
                      "enum": [
                        "DEF_MARKER_TYPE",
                        "NONE",
                        "OPEN",
                        "BLOCK",
                        "CLASSIC",
                        "DIAMOND",
                        "OVAL"
                      ]
                    },
                    "connector_type": {
                      "description": "LINE (straight), ELBOW or CURVE (the zoho.graphikos.Connector.ConnectorType names; there is no STRAIGHT); default chosen by the router.",
                      "type": "string",
                      "maxLength": 10,
                      "enum": [
                        "LINE",
                        "ELBOW",
                        "CURVE"
                      ]
                    },
                    "label": {
                      "description": "Optional text on the connector, for example Yes or No after a DECISION.",
                      "type": "string",
                      "maxLength": 5000
                    },
                    "end_marker": {
                      "description": "Arrowhead at the target end: NONE, OPEN, BLOCK, CLASSIC, DIAMOND or OVAL; default an arrow.",
                      "type": "string",
                      "maxLength": 20,
                      "enum": [
                        "DEF_MARKER_TYPE",
                        "NONE",
                        "OPEN",
                        "BLOCK",
                        "CLASSIC",
                        "DIAMOND",
                        "OVAL"
                      ]
                    },
                    "to_node_id": {
                      "description": "node_id of the edge's target node.",
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "from_node_id",
                    "to_node_id"
                  ]
                }
              },
              "layout_direction": {
                "description": "TOP_DOWN (default) or LEFT_RIGHT flow of the layered layout.",
                "type": "string",
                "maxLength": 20,
                "enum": [
                  "TOP_DOWN",
                  "LEFT_RIGHT"
                ]
              },
              "title": {
                "description": "Optional diagram title rendered above the chart.",
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "nodes"
            ]
          },
          "absolute_bounds": {
            "description": "Position and size on the slide the generated flowchart is fitted into. The server chooses a placement when omitted.",
            "type": "object",
            "properties": {
              "x": {
                "format": "float",
                "description": "Left edge in slide px.",
                "type": "number"
              },
              "width": {
                "format": "float",
                "description": "Width in slide px.",
                "type": "number"
              },
              "y": {
                "format": "float",
                "description": "Top edge in slide px.",
                "type": "number"
              },
              "height": {
                "format": "float",
                "description": "Height in slide px.",
                "type": "number"
              }
            }
          }
        },
        "required": [
          "payload"
        ]
      },
      "ShowEnvelope": {
        "description": "Standard Zoho Show response envelope.",
