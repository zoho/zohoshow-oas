          },
          "status": {
            "type": "string"
          }
        }
      },
      "ShowError": {
        "description": "Standard Zoho Show error response.",
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "details": {
                "additionalProperties": true,
                "type": "object",
                "properties": {
                  "error_code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "request_uri": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
