{
  "components": {
    "schemas": {
      "PublishParamsRequest": {
        "type": "object",
        "properties": {
          "allow_download": {
            "description": "Whether visitors to the published page may download the presentation.",
            "type": "boolean"
          },
          "auto_republish": {
            "description": "Keep the published copy in step with the presentation automatically, so later edits reach visitors without another publish call.",
            "type": "boolean"
          },
          "update_show_explainer": {
            "description": "Whether the published page displays the explainer panel shown alongside the slides.",
            "type": "boolean"
          },
          "bg_color": {
            "pattern": "^(?:(?:#|0x)(?:[a-f0-9]{3}|[a-f0-9]{6})\\b|(?:rgb|hsl)a?\\([^\\)]*\\))$",
            "description": "Background color of the published page, given as a CSS color: a 3- or 6-digit hex value prefixed with # or 0x, or an rgb(), rgba(), hsl() or hsla() function.",
            "type": "string"
          },
          "allow_share": {
            "description": "Whether visitors to the published page may share its link onward.",
            "type": "boolean"
          },
          "update_show_logo": {
            "description": "Whether the Zoho Show logo is displayed on the published page.",
            "type": "boolean"
          },
          "update_public_type": {
            "description": "Changes who the publication is visible to: 1 restricts it to the owner's organization, 2 opens it to the external world.",
            "type": "string",
            "enum": [
              "1",
              "2"
            ]
          },
          "republish": {
            "description": "Push the presentation's current content to the already-published copy, replacing what visitors currently see. Use this after editing a presentation that is already published.",
            "type": "boolean"
          },
          "allow_translate": {
            "description": "Whether the published page offers visitors a translation of the slide text.",
            "type": "boolean"
          },
          "viewtype": {
            "format": "int32",
            "description": "Layout used to render the published presentation, an integer from 1 to 12. Defaults to 1 when omitted or when the value is not recognized; several of the higher layouts add a slide-thumbnail strip.",
            "type": "integer"
          },
          "update_user_pic": {
            "description": "Whether the publisher's profile picture is displayed on the published page.",
            "type": "boolean"
          },
          "loop_show": {
            "description": "Whether the slideshow returns to the first slide when it reaches the end instead of stopping.",
            "type": "boolean"
          }
        }
      },
      "PublishTypeParamsRequest": {
        "type": "object",
        "properties": {
          "type": {
            "description": "Audience the publication is aimed at: ORG_PUBLISH makes it visible only inside the owner's organization, EXTERNAL_WORLD opens it to anyone holding the link. Mandatory.",
            "type": "string",
            "enum": [
              "ORG_PUBLISH",
              "EXTERNAL_WORLD"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "ShowEnvelope": {
        "description": "Standard Zoho Show response envelope.",
        "type": "object",
        "properties": {
          "data": {
            "description": "Operation payload; endpoint-specific schemas narrow this where available.",
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "request_uri": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ShowError": {
        "description": "Standard Zoho Show error response.",
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "details": {
                "additionalProperties": true,
                "type": "object",
                "properties": {
                  "error_code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "request_uri": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
