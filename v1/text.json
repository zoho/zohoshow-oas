        "summary": "Get text of a text-bearing object in a slide (fetch_type: text | length | paragraph_count | paragraph_text)",
        "security": [
          {
            "iam-oauth2-schema": [
              "ZohoShow.showdocslist.READ"
            ]
          }
        ],
        "operationId": "getPresentationByPresentationIdByContain06865ee9",
        "description": "Get text of a text-bearing object in a slide (fetch_type: text | length | paragraph_count | paragraph_text)",
        "responses": {
          "200": {
            "description": "Text Content Retrieved",
