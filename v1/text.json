              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShowEnvelope"
                },
                "examples": {
                  "text_content_retrieved": {
                    "value": {
                      "data": {
                        "text": "Hello World Sample"
                      },
                      "message": "Text retrieved successfully",
                      "request_uri": "/api/v1/presentation/8i4vv3f345fcf907446a2bdc4e2c871fc585e/slides/68a483f2-06e3-488d-a53c-bbe7d4f69998/text/c7538ec8-cdeb-42fb-9a10-2bcd9995dd1c",
                      "status": "success"
                    },
                    "summary": "Text Content Retrieved"
                  },
                  "text_length_retrieved": {
                    "value": {
                      "data": {
                        "length": 18
                      },
                      "message": "Text retrieved successfully",
                      "request_uri": "/api/v1/presentation/8i4vv3f345fcf907446a2bdc4e2c871fc585e/slides/68a483f2-06e3-488d-a53c-bbe7d4f69998/text/3d672ca2-f80e-428b-9fc5-b3e416791719",
                      "status": "success"
                    },
                    "summary": "fetch_type=length"
                  },
                  "paragraph_count_retrieved": {
                    "value": {
                      "data": {
                        "paragraph_count": 1
                      },
                      "message": "Text retrieved successfully",
                      "request_uri": "/api/v1/presentation/8i4vv3f345fcf907446a2bdc4e2c871fc585e/slides/68a483f2-06e3-488d-a53c-bbe7d4f69998/text/7aacfb47-e5a7-47d4-b5d6-5203727efb6b",
                      "status": "success"
                    },
                    "summary": "fetch_type=paragraph_count"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid Text Range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShowError"
                },
                "examples": {
