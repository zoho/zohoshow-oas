{
  "components": {
    "schemas": {
      "ShareParamsRequest": {
        "type": "object",
        "properties": {
          "email_id": {
            "pattern": "^(?:[a-zA-Z0-9 ._@+\\-,]*)$",
            "description": "Email address or Zoho username identifying a single member of the presentation.",
            "type": "string"
          }
        }
      },
      "ShareDocumentParamsRequest": {
        "type": "object",
        "properties": {
          "email_ids": {
            "pattern": "^(?:[a-zA-Z0-9 ._@+\\-,]*)$",
            "description": "Comma-separated email addresses  to share the presentation with, up to 255 characters in total.",
            "type": "string",
            "maxLength": 255
          },
          "role": {
            "description": "Access level granted to every recipient in this request, in increasing order of access: VIEWER may only read, COMMENTOR may read and comment, COLLABORATOR may read and edit, COOWNER may also manage the presentation and its members. Mandatory.",
            "type": "string",
            "enum": [
              "VIEWER",
              "COLLABORATOR",
              "COOWNER",
              "COMMENTOR"
            ]
          },
          "allow_sharing_outside": {
            "description": "Whether the recipients may share the presentation onward with people who are not already on it. They cannot when omitted.",
            "type": "boolean"
          }
        },
        "required": [
          "role"
        ]
      },
      "ShowEnvelope": {
        "description": "Standard Zoho Show response envelope.",
        "type": "object",
        "properties": {
          "data": {
            "description": "Operation payload; endpoint-specific schemas narrow this where available.",
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "request_uri": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ShowError": {
        "description": "Standard Zoho Show error response.",
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "details": {
                "additionalProperties": true,
                "type": "object",
                "properties": {
                  "error_code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "request_uri": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "UpdateRoleParamsRequest": {
        "type": "object",
        "properties": {
          "share_params": {
            "description": "Identifies the existing member whose access level is being changed, by email address or username.",
            "type": "object",
            "properties": {
              "email_id": {
                "pattern": "^(?:[a-zA-Z0-9 ._@+\\-,]*)$",
                "description": "Email address or Zoho username identifying a single member of the presentation.",
                "type": "string"
              }
            }
          },
          "role": {
            "description": "New access level for that member: VIEWER, COMMENTOR, COLLABORATOR or COOWNER, in increasing order of access. Mandatory.",
            "type": "string",
            "enum": [
              "VIEWER",
              "COLLABORATOR",
              "COOWNER",
              "COMMENTOR"
            ]
          }
        },
        "required": [
          "role"
        ]
      }
    },
    "responses": {
      "SuccessfulResponse": {
        "description": "Successful response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ShowEnvelope"
            }
          }
        }
